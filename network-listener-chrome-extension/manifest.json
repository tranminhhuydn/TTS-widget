{
  "manifest_version": 3,
  "name": "Network Listener",
  "version": "1.0.0",
  "description": "Theo dõi Network của tab hiện tại và xem nội dung response dạng văn bản.",
  "permissions": ["debugger", "tabs", "storage"],
  "action": {
    "default_title": "Network Listener",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "32": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "background": {"service_worker": "background.js"}
}